# Supabase dashboard > Project Settings > API (ya "Connect" button) se copy karo.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# Publishable key (sb_publishable_...) ya purani "anon public" key. Dono chalengi.
# Kabhi bhi secret / service_role key yahan mat daalna.
VITE_SUPABASE_KEY=your-publishable-or-anon-key
# Google login setup kiya ho tabhi true karo.
VITE_ENABLE_GOOGLE=false
